{
  "compilerOptions": {
    "target": "ES2019",
    "module": "es2020",
    "lib": ["ES2019", "DOM"],
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["vendor", "event-log-generation", "state-aware-opid-discovery"],
  "exclude": ["node_modules", "dist"],
  // The build emits ES modules (for bundlers); ts-node runs the CLI as CommonJS.
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}
